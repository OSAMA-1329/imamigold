# =============================================================
# Business Communication Hub — Example Environment File
# Copy this file to `.env` and fill in real values when wiring
# up a backend. The current app is frontend-only with mock data,
# so nothing here is required to run it.
# =============================================================

# ---- App ----
VITE_APP_NAME="Business Communication Hub"
VITE_APP_ENV="development"

# ---- REST API ----
# Base URL of your backend REST API (used by future fetch calls)
VITE_API_BASE_URL="https://api.example.com"
VITE_API_TIMEOUT_MS="15000"

# ---- Auth ----
# JWT / session endpoints
VITE_AUTH_LOGIN_URL="/auth/login"
VITE_AUTH_SIGNUP_URL="/auth/signup"
VITE_AUTH_ME_URL="/auth/me"
VITE_AUTH_LOGOUT_URL="/auth/logout"
VITE_AUTH_TOKEN_STORAGE_KEY="bch_token"

# ---- Realtime (Socket.IO) ----
# Leave VITE_SOCKET_URL empty to disable realtime and use local mock mode.
# Example: "https://api.example.com" or "wss://api.example.com"
VITE_SOCKET_URL=""
VITE_SOCKET_PATH="/socket.io"

# Socket.IO event names (for reference — the client uses these constants):
#   client -> server: chat:join, chat:leave, message:send, message:delete,
#                     chat:delete, chat:typing, message:read
#   server -> client: message:new, message:deleted, message:status,
#                     chat:deleted, presence:update, chat:typing:update

# ---- File uploads ----
VITE_UPLOAD_URL="/uploads"
VITE_MAX_UPLOAD_MB="20"

# ---- Push notifications (optional) ----
VITE_VAPID_PUBLIC_KEY=""

# ---- Third-party (optional) ----
VITE_SENTRY_DSN=""
VITE_GA_MEASUREMENT_ID=""
